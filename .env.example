# Copy to .env and fill in your local PostgreSQL credentials.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/log_monitor

# Used by the AI agent (not wired yet).
GROQ_API_KEY=
# Optional extra keys, used round-robin with GROQ_API_KEY (one per model built).
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_MODEL=openai/gpt-oss-120b

# Secret that gives each hidden e-mail a stable per-person code, [REDACTED:email:u...]. Leave empty for plain masks.
# Create one: python -c "import secrets; print(secrets.token_urlsafe(32))"
PSEUDONYM_KEY=

# Docker Compose only (docker compose up --build): credentials for the bundled Postgres.
# POSTGRES_USER=logmon
# POSTGRES_PASSWORD=change-me
# WEB_PORT=8080
