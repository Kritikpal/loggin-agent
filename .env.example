# Copy to .env and fill in your local PostgreSQL credentials.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/ai_business_operator

# Optional. Defaults to "<database name>_test" on the same server.
# Tests refuse to run against a database whose name does not end in "_test".
# TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/ai_business_operator_test

# Required for POST /api/v1/ai/chat.
GROQ_API_KEY=
# Optional; must be a Groq model that supports tool calling.
# GROQ_MODEL=openai/gpt-oss-120b
